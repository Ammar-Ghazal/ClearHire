# Copy to .env (cp .env.example .env). Never commit .env.

NODE_ENV=development
PORT=3001

# The web app's origin, and the API's public base URL as the browser sees it
# (through the Vite /api proxy in development).
WEB_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:5173/api

# Matches docker-compose.yml
DATABASE_URL=postgres://clearhire:clearhire@localhost:5432/clearhire

# Run `pnpm gen:keys` and paste its two lines here.
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=

# Public client ID of the ClearHire GitHub App with device flow enabled.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=Iv23liOCYEunL3zG6QzR
GITHUB_CLIENT_SECRET=

# Web app (production only; development uses the /api proxy)
# VITE_API_URL=

# --- Google sign-in for employers (Google Cloud Console → Credentials → OAuth client) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Meta Model API (skill analysis and matching) ---
# Key from your Meta Model API dashboard. Server-side only; never prefix with VITE_.
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3-contributor

# --- Modal (Sandboxes for repo code) ---
# modal.com → Settings → API tokens → New token
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=