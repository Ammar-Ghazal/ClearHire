# Copy to .env (cp .env.example .env). Never commit .env.

NODE_ENV=development
PORT=3001

# The web app's origin, and the API's public base URL as the browser sees it
# (through the Vite /api proxy in development).
WEB_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:5173/api

# Matches docker-compose.yml
DATABASE_URL=postgres://hireproof:hireproof@localhost:5432/hireproof

# Run `pnpm gen:keys` and paste its two lines here.
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=

# GitHub App (development) - see SETUP.md step 3
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Web app (production only; development uses the /api proxy)
# VITE_API_URL=
